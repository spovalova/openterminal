[
  {
    "connector": "yahoo",
    "route": "search",
    "summary": "Search Yahoo Finance for symbols by name or ticker",
    "description": "yahoo-finance2 search: up to ten quote hits for one free-text term (equities, ETFs, indices, funds, currencies, crypto), each with its exchange and type. One term per call.",
    "params": [{ "name": "q", "type": "string", "required": true, "description": "A name or ticker to look up" }],
    "providers": [],
    "fields": [
      { "name": "query", "type": "string", "description": "The search term" },
      { "name": "symbol", "type": "string" },
      { "name": "shortname", "type": "string" },
      { "name": "longname", "type": "string" },
      { "name": "exchange", "type": "string", "description": "Yahoo exchange code (NMS, NYQ, PCX)" },
      { "name": "exchDisp", "type": "string", "description": "Exchange display name" },
      { "name": "quoteType", "type": "string", "description": "EQUITY, ETF, INDEX, MUTUALFUND, CURRENCY, CRYPTOCURRENCY" },
      { "name": "typeDisp", "type": "string" },
      { "name": "sector", "type": "string" },
      { "name": "industry", "type": "string" },
      { "name": "score", "type": "number", "description": "Yahoo relevance score" },
      { "name": "isYahooFinance", "type": "boolean" }
    ]
  },
  {
    "connector": "yahoo",
    "route": "quote",
    "summary": "Latest quote per symbol",
    "description": "yahoo-finance2 quote: regular-session price, change, volume and market state, with pre- and post-market figures when that session is live, plus the valuation and range fields Yahoo attaches. Change percent is already a percent.",
    "params": [{ "name": "symbols", "type": "string[]", "required": true, "description": "Ticker symbols" }],
    "providers": [],
    "fields": [
      { "name": "symbol", "type": "string" },
      { "name": "shortName", "type": "string" },
      { "name": "longName", "type": "string" },
      { "name": "quoteType", "type": "string" },
      { "name": "exchange", "type": "string" },
      { "name": "fullExchangeName", "type": "string" },
      { "name": "currency", "type": "string" },
      { "name": "marketState", "type": "string", "description": "PRE, REGULAR, POST, CLOSED" },
      { "name": "regularMarketPrice", "type": "number", "description": "Last regular-session price" },
      { "name": "regularMarketChange", "type": "number" },
      { "name": "regularMarketChangePercent", "type": "number", "description": "Percent, not a fraction" },
      { "name": "regularMarketPreviousClose", "type": "number" },
      { "name": "regularMarketOpen", "type": "number" },
      { "name": "regularMarketDayHigh", "type": "number" },
      { "name": "regularMarketDayLow", "type": "number" },
      { "name": "regularMarketVolume", "type": "number" },
      { "name": "regularMarketTime", "type": "time" },
      { "name": "preMarketPrice", "type": "number" },
      { "name": "preMarketChange", "type": "number" },
      { "name": "preMarketChangePercent", "type": "number" },
      { "name": "preMarketTime", "type": "time" },
      { "name": "postMarketPrice", "type": "number" },
      { "name": "postMarketChange", "type": "number" },
      { "name": "postMarketChangePercent", "type": "number" },
      { "name": "postMarketTime", "type": "time" },
      { "name": "bid", "type": "number" },
      { "name": "ask", "type": "number" },
      { "name": "averageDailyVolume3Month", "type": "number" },
      { "name": "averageDailyVolume10Day", "type": "number" },
      { "name": "fiftyTwoWeekHigh", "type": "number" },
      { "name": "fiftyTwoWeekLow", "type": "number" },
      { "name": "fiftyDayAverage", "type": "number" },
      { "name": "twoHundredDayAverage", "type": "number" },
      { "name": "marketCap", "type": "number" },
      { "name": "sharesOutstanding", "type": "number" },
      { "name": "trailingPE", "type": "number" },
      { "name": "forwardPE", "type": "number" },
      { "name": "epsTrailingTwelveMonths", "type": "number" },
      { "name": "epsForward", "type": "number" },
      { "name": "priceToBook", "type": "number" },
      { "name": "bookValue", "type": "number" },
      { "name": "dividendYield", "type": "number", "description": "Percent as Yahoo sends it" },
      { "name": "dividendRate", "type": "number" },
      { "name": "earningsTimestamp", "type": "time" },
      { "name": "dividendDate", "type": "time" }
    ]
  },
  {
    "connector": "yahoo",
    "route": "chart",
    "summary": "Price bars for one or more symbols between two instants",
    "description": "yahoo-finance2 chart: OHLCV bars per symbol from period1 to period2 (now when omitted) at an interval; intraday intervals reach back about 60 days, 1m about 7. With `events` the rows are those events instead of bars (dividends as date and dividends.amount; splits as date and splits.numerator, splits.denominator). Bars are stamped at the session instant in UTC; daily bars at the New York open.",
    "params": [
      { "name": "symbol", "type": "string[]", "required": true, "description": "Ticker symbols; one chart call each" },
      { "name": "period1", "type": "date", "required": true, "description": "Start date (YYYY-MM-DD)" },
      { "name": "period2", "type": "date", "required": false, "description": "End date; now when omitted" },
      { "name": "interval", "type": "string", "required": false, "default": "1d", "enum": ["1m", "2m", "5m", "15m", "30m", "60m", "90m", "1h", "1d", "5d", "1wk", "1mo", "3mo"] },
      { "name": "includePrePost", "type": "boolean", "required": false, "default": false, "description": "Include pre- and post-market bars on intraday intervals" },
      { "name": "events", "type": "string", "required": false, "description": "Return events instead of bars: div, split, or div|split" }
    ],
    "providers": [],
    "fields": [
      { "name": "symbol", "type": "string" },
      { "name": "date", "type": "time", "description": "Bar instant" },
      { "name": "open", "type": "number" },
      { "name": "high", "type": "number" },
      { "name": "low", "type": "number" },
      { "name": "close", "type": "number" },
      { "name": "volume", "type": "number" },
      { "name": "adjclose", "type": "number", "description": "Split- and dividend-adjusted close on daily and longer intervals" }
    ]
  },
  {
    "connector": "yahoo",
    "route": "options",
    "summary": "Option chain for one symbol at one expiration",
    "description": "yahoo-finance2 options: calls and puts for the nearest listed expiration, or the first listed expiration on or after `date`. One row per contract with the underlying's last price; implied volatility is a fraction. No greeks.",
    "params": [
      { "name": "symbol", "type": "string", "required": true, "description": "Underlying ticker" },
      { "name": "date", "type": "date", "required": false, "description": "Expiration; snaps forward to the first listed expiration on or after it" }
    ],
    "providers": [],
    "fields": [
      { "name": "symbol", "type": "string", "description": "Underlying" },
      { "name": "expiration", "type": "time" },
      { "name": "type", "type": "string", "description": "call or put" },
      { "name": "strike", "type": "number" },
      { "name": "contractSymbol", "type": "string" },
      { "name": "lastPrice", "type": "number" },
      { "name": "bid", "type": "number" },
      { "name": "ask", "type": "number" },
      { "name": "change", "type": "number" },
      { "name": "percentChange", "type": "number", "description": "Percent, not a fraction" },
      { "name": "volume", "type": "number" },
      { "name": "openInterest", "type": "number" },
      { "name": "impliedVolatility", "type": "number", "description": "Fraction (0.78 = 78%)" },
      { "name": "inTheMoney", "type": "boolean" },
      { "name": "lastTradeDate", "type": "time" },
      { "name": "underlyingPrice", "type": "number", "description": "The underlying's regular-market price when the chain was fetched" }
    ]
  },
  {
    "connector": "yahoo",
    "route": "quoteSummary",
    "summary": "Company data modules per symbol, flattened to module.field columns",
    "description": "yahoo-finance2 quoteSummary: the requested modules for each symbol. Scalar modules (price, summaryDetail, defaultKeyStatistics, financialData, assetProfile, calendarEvents) become one row per symbol with columns like financialData.grossMargins; list modules (earningsHistory, earningsTrend, insiderTransactions, institutionOwnership, topHoldings, upgradeDowngradeHistory) become one row per item with columns like insiderTransactions.shares. Margins, growth, yields and percentages are fractions. Columns are inferred from the response.",
    "params": [
      { "name": "symbol", "type": "string[]", "required": true, "description": "Ticker symbols; one call each" },
      {
        "name": "modules",
        "type": "string[]",
        "required": true,
        "description": "Which modules to fetch",
        "enum": [
          "assetProfile",
          "balanceSheetHistory",
          "balanceSheetHistoryQuarterly",
          "calendarEvents",
          "cashflowStatementHistory",
          "cashflowStatementHistoryQuarterly",
          "defaultKeyStatistics",
          "earnings",
          "earningsHistory",
          "earningsTrend",
          "financialData",
          "fundOwnership",
          "fundPerformance",
          "fundProfile",
          "incomeStatementHistory",
          "incomeStatementHistoryQuarterly",
          "indexTrend",
          "industryTrend",
          "insiderHolders",
          "insiderTransactions",
          "institutionOwnership",
          "majorDirectHolders",
          "majorHoldersBreakdown",
          "netSharePurchaseActivity",
          "price",
          "quoteType",
          "recommendationTrend",
          "secFilings",
          "sectorTrend",
          "summaryDetail",
          "summaryProfile",
          "topHoldings",
          "upgradeDowngradeHistory"
        ]
      }
    ],
    "providers": [],
    "fields": [{ "name": "symbol", "type": "string" }]
  },
  {
    "connector": "yahoo",
    "route": "news",
    "summary": "Recent news headlines per symbol, newest first",
    "description": "yahoo-finance2 search with quotesCount 0: the news Yahoo Finance ties to each symbol, no API key. One call per symbol, merged newest first and de-duplicated by link. Columns match the OpenBB news routes: date, title, publisher, url, symbols (the tickers Yahoo relates to the story, comma separated).",
    "params": [
      { "name": "symbol", "type": "string[]", "required": true, "description": "Ticker symbols" },
      { "name": "limit", "type": "integer", "required": false, "default": 20, "description": "Headlines to ask Yahoo for per symbol" }
    ],
    "providers": [],
    "fields": [
      { "name": "date", "type": "time", "description": "Published at" },
      { "name": "title", "type": "string" },
      { "name": "publisher", "type": "string" },
      { "name": "url", "type": "string" },
      { "name": "symbols", "type": "string", "description": "Tickers Yahoo relates to the story, comma separated" }
    ]
  }
]
